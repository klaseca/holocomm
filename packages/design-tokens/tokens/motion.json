{
  "duration": {
    "$type": "duration",
    "fast": { "$value": { "value": 120, "unit": "ms" } },
    "normal": { "$value": { "value": 180, "unit": "ms" } },
    "slow": { "$value": { "value": 240, "unit": "ms" } }
  },
  "ease": {
    "$type": "cubicBezier",
    "out": { "$value": [0.22, 0.61, 0.36, 1] },
    "in": { "$value": [0.55, 0.06, 0.68, 0.19] }
  }
}
