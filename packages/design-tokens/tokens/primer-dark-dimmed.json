{
  "base": {
    "color": {
      "blue": {
        "accent-foreground": {
          "$value": {
            "colorSpace": "hsl",
            "components": [215, 70, 61]
          },
          "$type": "color"
        }
      }
    }
  },
  "bgColor": {
    "default": { "$value": "{base.color.neutral.3}", "$type": "color" },
    "muted": { "$value": "{base.color.neutral.4}", "$type": "color" },
    "inset": { "$value": "{base.color.neutral.2}", "$type": "color" },
    "disabled": { "$value": "{base.color.neutral.5}", "$type": "color" }
  },
  "borderColor": {
    "default": { "$value": "{base.color.neutral.7}", "$type": "color" },
    "accent": {
      "emphasis": { "$value": "{base.color.blue.3}", "$type": "color" }
    }
  },
  "control": {
    "bgColor": {
      "rest": { "$value": "{base.color.neutral.5}", "$type": "color" },
      "hover": { "$value": "{base.color.neutral.6}", "$type": "color" }
    }
  },
  "fgColor": {
    "default": { "$value": "{base.color.neutral.11}", "$type": "color" },
    "onEmphasis": { "$value": "{base.color.neutral.12}", "$type": "color" },
    "disabled": { "$value": "{base.color.neutral.8}", "$type": "color" },
    "success": { "$value": "{base.color.green.3}", "$type": "color" },
    "attention": { "$value": "{base.color.yellow.2}", "$type": "color" },
    "danger": { "$value": "{base.color.red.3}", "$type": "color" }
  },
  "color": {
    "tooltip": {
      "background": { "$value": "{base.color.neutral.7}", "$type": "color" }
    },
    "content": {
      "accent": {
        "$value": "{base.color.blue.accent-foreground}",
        "$type": "color"
      }
    },
    "accent": {
      "hover": {
        "$value": {
          "colorSpace": "hsl",
          "components": [215.5, 68, 49]
        },
        "$type": "color"
      }
    },
    "action": {
      "danger": {
        "background-hover": {
          "$value": {
            "colorSpace": "hsl",
            "components": [2, 65, 50]
          },
          "$type": "color"
        }
      }
    }
  }
}
