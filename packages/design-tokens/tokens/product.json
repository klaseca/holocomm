{
  "font": {
    "sans": {
      "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"],
      "$type": "fontFamily",
      "$description": "Holocomm's system font stack without a bundled webfont."
    }
  },
  "layout": {
    "$type": "dimension",
    "$description": "Structural dimensions specific to the Holocomm application shell.",
    "app-navigation": {
      "$value": { "value": 72, "unit": "px" },
      "$description": "Width of the persistent room navigation rail."
    },
    "content-max": {
      "$value": { "value": 1152, "unit": "px" },
      "$description": "Maximum width of centered dashboard content."
    },
    "dialog-wide-max": {
      "$value": { "value": 720, "unit": "px" },
      "$description": "Width of the media settings dialog between Primer's large and xlarge overlays."
    },
    "scrollbar": {
      "$value": { "value": 10, "unit": "px" },
      "$description": "Width of the custom participant-list scrollbar."
    },
    "viewport-min": {
      "$value": { "value": 320, "unit": "px" },
      "$description": "Minimum viewport width supported by the application shell."
    }
  },
  "room": {
    "participant": {
      "speaking": {
        "boxShadow": {
          "$value": [
            {
              "color": "{bgColor.muted}",
              "offsetX": { "value": 0, "unit": "px" },
              "offsetY": { "value": 0, "unit": "px" },
              "blur": { "value": 0, "unit": "px" },
              "spread": "{base.size.2}"
            },
            {
              "color": "{borderColor.success.emphasis}",
              "offsetX": { "value": 0, "unit": "px" },
              "offsetY": { "value": 0, "unit": "px" },
              "blur": { "value": 0, "unit": "px" },
              "spread": "{base.size.4}"
            }
          ],
          "$type": "shadow",
          "$description": "Two-layer ring around an avatar while that participant is speaking."
        }
      }
    },
    "connection": {
      "online": {
        "boxShadow": {
          "$value": [
            {
              "color": "{bgColor.default}",
              "offsetX": { "value": 0, "unit": "px" },
              "offsetY": { "value": 0, "unit": "px" },
              "blur": { "value": 0, "unit": "px" },
              "spread": "{base.size.12}"
            }
          ],
          "$type": "shadow",
          "$description": "Outer separation ring around the room connection indicator."
        }
      }
    }
  },
  "themePreview": {
    "dark": {
      "canvas": {
        "bgColor": {
          "$value": { "colorSpace": "srgb", "components": [0.129412, 0.156863, 0.188235] },
          "$type": "color",
          "$description": "Dark theme canvas shown inside the theme picker."
        }
      },
      "navigation": {
        "bgColor": {
          "$value": { "colorSpace": "srgb", "components": [0.105882, 0.129412, 0.156863] },
          "$type": "color",
          "$description": "Dark theme navigation shown inside the theme picker."
        }
      },
      "panel": {
        "bgColor": {
          "$value": { "colorSpace": "srgb", "components": [0.176471, 0.207843, 0.247059] },
          "$type": "color",
          "$description": "Dark theme panel shown inside the theme picker."
        }
      }
    },
    "light": {
      "canvas": {
        "bgColor": {
          "$value": { "colorSpace": "srgb", "components": [0.964706, 0.972549, 0.980392] },
          "$type": "color",
          "$description": "Light theme canvas shown inside the theme picker."
        }
      },
      "navigation": {
        "bgColor": {
          "$value": { "colorSpace": "srgb", "components": [0.917647, 0.933333, 0.94902] },
          "$type": "color",
          "$description": "Light theme navigation shown inside the theme picker."
        }
      },
      "panel": {
        "bgColor": {
          "$value": { "colorSpace": "srgb", "components": [1, 1, 1] },
          "$type": "color",
          "$description": "Light theme panel shown inside the theme picker."
        }
      }
    }
  }
}
