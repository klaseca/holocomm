{
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["JetBrains Mono", "ui-monospace", "monospace"]
    }
  },
  "font-size": {
    "$type": "dimension",
    "xs": { "$value": { "value": 12, "unit": "px" } },
    "sm": { "$value": { "value": 14, "unit": "px" } },
    "md": { "$value": { "value": 16, "unit": "px" } },
    "lg": { "$value": { "value": 20, "unit": "px" } },
    "xl": { "$value": { "value": 32, "unit": "px" } },
    "2xl": { "$value": { "value": 40, "unit": "px" } }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 }
  },
  "line-height": {
    "$type": "number",
    "compact": { "$value": 1.3 },
    "body": { "$value": 1.5 },
    "relaxed": { "$value": 1.55 }
  }
}
